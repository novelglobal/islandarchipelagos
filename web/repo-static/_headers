# Headers for every page and file Cloudflare serves from dist/. This file itself is never served.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(), usb=(self), serial=(self), bluetooth=(self)
  Strict-Transport-Security: max-age=31536000

# the approval page: never kept, never indexed, never framed, and its script only from here
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' blob:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' blob:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
/admin.js
  Cache-Control: no-store

# the islands: asked fresh each time
/islands
  Cache-Control: no-cache

# a private page: never kept, never indexed, never framed
/note
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
/note.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

# a pop-up's desk: never kept, never indexed, never framed
/desk
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
/desk.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

# an island's twin: never indexed; the one page that may reach a printer or a radio beside the screen (USB, serial, Bluetooth)
/twin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
  Referrer-Policy: no-referrer
  ! Permissions-Policy
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(self), serial=(self), bluetooth=(self)
/twin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
  Referrer-Policy: no-referrer
  ! Permissions-Policy
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(self), serial=(self), bluetooth=(self)

# an island keeper's key page: never kept, never indexed
/island
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer
/island.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer
