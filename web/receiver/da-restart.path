# RESTART on the approval page or the desk: the bridge (pull.py) leaves a note in /run/da-pull; this unit sees it and starts
# da-restart.service, which turns the Pi off and on again safely. Installed by receiver/setup/install.sh.
[Unit]
Description=Restart this Pi when the approval page asks

[Path]
PathExists=/run/da-pull/restart

[Install]
WantedBy=multi-user.target
