{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:island:0.1:style",
  "title": "A style pack: how a receipt looks",
  "description": "1.0 C's style format, as drafted in novel.global's src/base/thermal.js (T.clean and T.pack) on 6 November 2026, wrapped in the pack header. A mod pack there is { name, by, styles }; here the header carries name and by. Check again when 1.0 C lands: its T.clean is the authority, and this schema follows it.",
  "type": "object",
  "allOf": [{ "$ref": "urn:island:0.1:common#/$defs/packHeader" }],
  "required": ["styles"],
  "unevaluatedProperties": false,
  "properties": {
    "pack": { "const": "style" },
    "styles": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/style" } }
  },
  "$defs": {
    "fontKey": { "description": "One of the engine's faces, at an optional weight, or a font the style carries", "type": "string", "pattern": "^((sans|narrow|serif|mono|hand)(:[1-9]00)?|asset:[A-Za-z0-9_-]{1,24})$" },
    "fonts": {
      "type": "object", "additionalProperties": false,
      "properties": { "head": { "$ref": "#/$defs/fontKey" }, "body": { "$ref": "#/$defs/fontKey" }, "small": { "$ref": "#/$defs/fontKey" } }
    },
    "style": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "name": { "type": "string", "maxLength": 24 },
        "by": { "type": "string", "maxLength": 40 },
        "fonts": { "description": "On paper", "$ref": "#/$defs/fonts" },
        "screen": { "description": "On screen, else the same as on paper", "$ref": "#/$defs/fonts" },
        "size": { "description": "The words on paper against the poster as drawn (1.3: a third bigger)", "type": "number", "minimum": 0.8, "maximum": 2 },
        "lead": { "description": "Line spacing", "type": "number", "minimum": 0.8, "maximum": 1.6 },
        "margin": { "type": "number", "minimum": 0.5, "maximum": 1.8 },
        "photo": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "dither": { "enum": ["auto", "atkinson", "floyd", "bayer", "none"] },
            "contrast": { "type": "number", "minimum": 0, "maximum": 1 },
            "sharpen": { "type": "number", "minimum": 0, "maximum": 2.5 },
            "gamma": { "type": "number", "minimum": 0.3, "maximum": 1.6 }
          }
        },
        "frame": { "description": "Round the picture", "enum": ["hand", "rule", "box", "none"] },
        "rule": { "description": "Under the words", "enum": ["dots", "solid", "none"] },
        "top": { "description": "The mark and the name, or the same reversed out of a solid band", "enum": ["mark", "band", "none"] },
        "night": { "description": "A dark print solid black, or a fine shade", "enum": ["solid", "shade"] },
        "colours": {
          "type": "object", "required": ["paper", "ink"], "additionalProperties": false,
          "properties": { "paper": { "$ref": "urn:island:0.1:common#/$defs/colour" }, "ink": { "$ref": "urn:island:0.1:common#/$defs/colour" } }
        },
        "mark": { "description": "An image asset printed at the foot", "type": "string", "pattern": "^[A-Za-z0-9_-]{1,24}$" },
        "assets": {
          "description": "Fonts (woff2, woff, ttf, otf) and images (png, jpeg, webp) as data URLs: six at most, 90 KB together",
          "type": "object", "maxProperties": 6, "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,24}$" },
          "additionalProperties": { "type": "string", "pattern": "^data:(font/(woff2|woff|ttf|otf)|image/(png|jpeg|webp));base64,[A-Za-z0-9+/=]+$" }
        }
      }
    }
  }
}
