{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:island:0.1:profile",
  "title": "A printer profile",
  "description": "One printer model as data: what it prints and how. Supporting another model is a new profile, never a change to the engine",
  "type": "object",
  "required": ["profile", "id", "name", "protocol", "dpi", "papers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "profile": { "const": "printer" },
    "id": { "$ref": "urn:island:0.1:common#/$defs/id" },
    "name": { "type": "string", "maxLength": 60 },
    "about": { "type": "string", "maxLength": 200 },
    "protocol": { "description": "How it is spoken to: ESC/POS (Epson and most others) or Star", "enum": ["escpos", "star"] },
    "dpi": { "type": "integer", "minimum": 100, "maximum": 400 },
    "papers": {
      "description": "Each paper width it takes, and the dots it prints across on it",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["paper", "dots"],
        "additionalProperties": false,
        "properties": {
          "paper": { "enum": [58, 80] },
          "dots": { "type": "integer", "minimum": 160, "maximum": 1024 }
        }
      }
    },
    "cutter": { "description": "full, partial (a tab left to tear), or none (torn on the teeth)", "enum": ["full", "partial", "none"] },
    "speed": { "description": "Millimetres of paper a second, at most", "type": "integer", "minimum": 10, "maximum": 1000 },
    "darkness": {
      "description": "How dark it prints, in percent of the maker's normal",
      "type": "object",
      "required": ["min", "max", "default"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 10, "maximum": 200 },
        "max": { "type": "integer", "minimum": 10, "maximum": 200 },
        "default": { "type": "integer", "minimum": 10, "maximum": 200 }
      }
    },
    "usb": {
      "description": "How it is known on USB, as hex vendor and product ids",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
        "product": { "type": "string", "pattern": "^[0-9a-f]{4}$" }
      }
    },
    "port": { "description": "Its network port, when it has one (9100 on most)", "type": "integer", "minimum": 1, "maximum": 65535 }
  }
}
