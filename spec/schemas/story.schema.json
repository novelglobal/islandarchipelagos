{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:island:0.1:story",
  "title": "A story pack: finished games as boxes on the shelf",
  "description": "A story box is a journey already played: its cover, its headline fact, and up to five receipts, each a template filled with what was made. It shows how someone landed on the idea, step by step, and ends on the way to play your own.",
  "type": "object",
  "allOf": [{ "$ref": "urn:island:0.1:common#/$defs/packHeader" }],
  "required": ["stories"],
  "unevaluatedProperties": false,
  "properties": {
    "pack": { "const": "story" },
    "stories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/box" } }
  },
  "$defs": {
    "value": { "oneOf": [{ "type": "string", "maxLength": 300 }, { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 200 } }] },
    "box": {
      "type": "object", "required": ["id", "title", "cover", "headline", "journey", "receipts"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "urn:island:0.1:common#/$defs/id" },
        "title": { "type": "string", "maxLength": 40 },
        "cover": {
          "description": "Drawn by its maker, or made from a photograph by the pixel maker",
          "type": "object", "additionalProperties": false,
          "properties": {
            "file": { "$ref": "urn:island:0.1:common#/$defs/path" },
            "from": { "enum": ["drawn", "photo"] },
            "cells": { "description": "The pixel grid across", "enum": [24, 40, 64] },
            "subject": { "description": "What the cover shows, for whoever draws it", "type": "string", "maxLength": 200 }
          }
        },
        "headline": {
          "type": "object", "required": ["text", "src"], "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "maxLength": 160 },
            "src": { "description": "Every headline has a source", "type": "string", "pattern": "^https?://" },
            "checked": { "description": "false until the fact has been checked against its source", "type": "boolean" }
          }
        },
        "journey": { "description": "The steps pack the receipts were made in", "$ref": "urn:island:0.1:common#/$defs/packId" },
        "lives": { "type": "array", "items": { "$ref": "urn:island:0.1:common#/$defs/id" } },
        "brief": { "description": "A case it answers, from the lives pack", "type": "string", "maxLength": 40 },
        "receipts": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object", "required": ["template", "fill"], "additionalProperties": false,
            "properties": {
              "template": { "$ref": "urn:island:0.1:common#/$defs/id" },
              "fill": {
                "description": "What was made, by piece path (step.field or step.field.line)",
                "type": "object", "propertyNames": { "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+(\\.[a-z0-9-]+)?$" },
                "additionalProperties": { "$ref": "#/$defs/value" }
              },
              "sources": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } }
            }
          }
        },
        "unlocks": { "description": "Board stages it grows when played through", "type": "array", "items": { "$ref": "urn:island:0.1:common#/$defs/id" } }
      }
    }
  }
}
